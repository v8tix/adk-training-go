# Copy to .env and adjust as needed. Every value below has a working
# default (see internal/infrastructure/llm/config.go) — you only need a
# .env file at all if you want to override one of them.

# Which model factory to use: "ollama" (default, no cloud credentials
# needed) or "gemini" (checks Google Cloud/AI Studio credentials).
MODEL_TYPE=ollama

# Local model (used when MODEL_TYPE=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
# GGUF (Q4_K_M), not this machine's faster MLX presets (nvfp4/mxfp8) — those
# return 501 "structured output is unavailable" for any module using
# llmagent.Config.OutputSchema (confirmed live, module-4). This one quant
# supports both plain-text and structured-output modules, so every module
# shares it — see docs/module-4/README.md for the full finding.
OLLAMA_MODEL=qwen3.8:27b

# Cloud model (used when MODEL_TYPE=gemini)
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_AI_STUDIO_API_KEY=
