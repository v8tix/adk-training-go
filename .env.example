# Copy to .env and adjust as needed. Every value below has a working
# default (see internal/infrastructure/llm/config.go) — you only need a
# .env file at all if you want to override one of them.

# Which model factory to use: "ollama" (default, no cloud credentials
# needed) or "gemini" (checks Google Cloud/AI Studio credentials).
MODEL_TYPE=ollama

# Local model (used when MODEL_TYPE=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
# GGUF (Q4_K_M), not this machine's faster MLX presets (nvfp4/mxfp8) — those
# return 501 "structured output is unavailable" for any module using
# llmagent.Config.OutputSchema (confirmed live, module-4). This one quant
# supports both plain-text and structured-output modules, so every module
# shares it — see docs/module-4/README.md for the full finding.
OLLAMA_MODEL=qwen3.8:27b

# Cloud model (used when MODEL_TYPE=gemini)
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_AI_STUDIO_API_KEY=

# Vertex AI (used by internal/agents/researchassistant's
# BuildMapsGroundingAgent — google_maps_grounding needs Vertex AI, the
# public Gemini API above doesn't support it). Two real, mutually exclusive
# auth paths — set one, not both:
#
# 1. VERTEX_AI_API_KEY — Express Mode (simplest, no gcloud install needed).
#    Must be generated through Vertex AI Studio's own Express enrollment
#    flow: console.cloud.google.com/vertex-ai/generative/express. A plain
#    Google Cloud API key does NOT work here — confirmed live, it fails with
#    401 CREDENTIALS_MISSING. Most new/eligible Google Cloud accounts can use
#    this; some existing accounts can't get an Express key at all.
# 2. VERTEX_AI_PROJECT + VERTEX_AI_LOCATION — Application Default
#    Credentials, the path every other Google Cloud SDK uses. Requires the
#    gcloud CLI: `gcloud auth application-default login`, then set these two
#    to your project ID and a Vertex AI region (e.g. us-east1). Used
#    automatically whenever VERTEX_AI_API_KEY is empty.
VERTEX_AI_API_KEY=
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=
# Vertex AI's publisher model catalog uses different, often-lagging model
# names than the public Gemini API above — confirmed live: GEMINI_MODEL's
# own default ("gemini-3.5-flash") 404s on Vertex; "gemini-2.5-flash" works.
VERTEX_AI_MODEL=gemini-2.5-flash

# GitHub Personal Access Token (read-only), used by cmd/mcp-github to
# connect to GitHub's remote MCP server. Create one at
# github.com/settings/personal-access-tokens/new.
GITHUB_TOKEN=
